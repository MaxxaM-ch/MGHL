---
import "../styles/components/game-card.scss";

interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a class="game-card" href={href}>
  <span class="game-card__accent" aria-hidden="true"></span>
  <h3 class="game-card__title">{title}</h3>
  <p class="game-card__description">{description}</p>
  <span class="game-card__cta">Jouer <span aria-hidden="true">→</span></span>
</a>
