---
import BaseLayout from "../layouts/BaseLayout.astro";
import GameCard from "../components/GameCard.astro";
---

<BaseLayout title="MGHL — Mini Games Hockey League">
  <main class="home">
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <img
        class="hero__logo hero__logo--light"
        src="/logo/mghl-full-color.svg"
        alt="MGHL — Mini Games Hockey League"
        width="984"
        height="265"
      />
      <img
        class="hero__logo hero__logo--dark"
        src="/logo/mghl-full-white.svg"
        alt="MGHL — Mini Games Hockey League"
        width="984"
        height="265"
      />
      <p class="hero__tagline">Un nouveau mini-jeu hockey à découvrir chaque jour.</p>
    </section>

    <section class="games">
      <h2 class="games__title">Nos jeux</h2>
      <div class="games__grid">
        <GameCard
          title="Devine le joueur"
          description="Trouve le joueur mystère du jour en 6 tentatives."
          href="/jeux/devine-le-joueur"
        />
      </div>
    </section>
  </main>
</BaseLayout>

<style lang="scss">
  @use "../styles/variables" as v;

  .home {
    max-width: v.$content-width;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero {
    position: relative;
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.5rem;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      135deg,
      var(--brand) 0,
      var(--brand) 1px,
      transparent 1px,
      transparent 14px
    );
    opacity: 0.05;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 72%);
    pointer-events: none;
  }

  .hero__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 700px;
    height: 700px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(14, 165, 168, 0.16), transparent 70%);
    pointer-events: none;
  }

  .hero__logo {
    position: relative;
    z-index: 1;
    width: min(90vw, 620px);
    height: auto;
    animation: fade-up 0.7s ease both;
  }

  .hero__logo--dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .hero__logo--light {
      display: none;
    }
    .hero__logo--dark {
      display: block;
    }
  }

  .hero__tagline {
    position: relative;
    z-index: 1;
    font-family: v.$font-body;
    font-size: 1.05rem;
    opacity: 0.8;
    margin: 0;
    animation: fade-up 0.7s ease 0.15s both;
  }

  .games {
    padding: 2rem 0 5rem;
  }

  .games__title {
    font-family: v.$font-display;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.5rem;
    margin: 0 0 1.5rem;
    animation: fade-up 0.7s ease 0.3s both;
  }

  .games__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    animation: fade-up 0.7s ease 0.45s both;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__logo,
    .hero__tagline,
    .games__title,
    .games__grid {
      animation: none;
    }
  }
</style>
