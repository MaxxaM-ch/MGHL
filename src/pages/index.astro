---
import BaseLayout from "../layouts/BaseLayout.astro";
import GameCard from "../components/GameCard.astro";
import "../styles/pages/home.scss";
---

<BaseLayout title="MGHL — Mini Games Hockey League">
  <main class="home">
    <section class="home-hero">
      <div class="home-hero__glow" aria-hidden="true"></div>
      <img
        class="home-hero__logo home-hero__logo--light"
        src="/logo/mghl-full-color.svg"
        alt="MGHL — Mini Games Hockey League"
        width="984"
        height="265"
      />
      <img
        class="home-hero__logo home-hero__logo--dark"
        src="/logo/mghl-full-white.svg"
        alt="MGHL — Mini Games Hockey League"
        width="984"
        height="265"
      />
      <p class="home-hero__tagline">Un nouveau mini-jeu hockey à découvrir chaque jour.</p>
    </section>

    <section class="home-games">
      <h2 class="home-games__title">Nos jeux</h2>
      <div class="home-games__grid">
        <GameCard
          title="Devine le joueur"
          description="Trouve le joueur mystère du jour en 6 tentatives."
          href="/games/guess-the-player"
          icon="/icons/guess-the-player.svg"
          iconDark="/icons/guess-the-player-dark.svg"
        />
        <GameCard
          title="Devine le logo"
          description="Trouve l'équipe mystère à partir de son logo en 6 tentatives."
          href="/games/guess-the-logo"
          icon="/icons/guess-the-logo.svg"
          iconDark="/icons/guess-the-logo-dark.svg"
          iconClass="game-card__icon--large"
        />
        <GameCard
          title="Arrêt ou but ?"
          description="Devine si chaque action se termine en but ou en arrêt, sur 5 clips."
          href="/games/arret-ou-but"
          icon="/icons/arret-ou-but.svg"
          iconDark="/icons/arret-ou-but-dark.svg"
        />
      </div>
    </section>
  </main>
</BaseLayout>
